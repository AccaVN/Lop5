# Lấy chuỗi này từ Neon dashboard > Connection string (nhớ dùng bản "pooled connection")
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Chuỗi bí mật để ký JWT — tạo 1 chuỗi ngẫu nhiên dài, KHÔNG dùng giá trị mẫu này khi deploy thật
JWT_SECRET=doi_chuoi_nay_thanh_chuoi_ngau_nhien_that_dai

PORT=4000

# ---- Giọng đọc (tùy chọn) ----
# Không cần gì thêm: mặc định dùng giọng Microsoft HoaiMy (nữ) / NamMinh (nam) miễn phí.
# Nếu muốn ổn định hơn, tạo Azure Speech (gói Free F0: 500.000 ký tự/tháng) rồi điền:
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# Muốn dùng thêm các giọng Google (Neural2 / Wavenet / Chirp3 HD) thì điền API key Google Cloud Text-to-Speech:
# GOOGLE_TTS_API_KEY=
