{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/favicon.ico",
      "status": 204,
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      }
    },
    {
      "src": "/voice-data.json",
      "dest": "/public/voice-data.json",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/banks/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/banks/$1"
    },
    {
      "src": "/emoji/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      },
      "dest": "/public/emoji/$1"
    },
    {
      "src": "/stickers/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "dest": "/public/stickers/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
      }
    }
  ],
  "regions": [
    "sin1"
  ]
}
